# Copy to .env locally. Never commit real secrets.
EODHD_API_KEY=
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=

# Optional: direct AI verification of imported financial data.
# This uses the OpenAI Responses API with web search and therefore requires API billing.
OPENAI_API_KEY=
OPENAI_REVIEW_MODEL=gpt-5.4

# Required only for official SEC EDGAR API access.
# The SEC asks automated clients to declare a User-Agent with contact information.
# Example: SEC_USER_AGENT=Your Name your.email@example.com
SEC_USER_AGENT=
